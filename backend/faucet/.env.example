FAUCET_RPC_URL=https://testnet.aurora.dev
FAUCET_CHAIN_ID=1313161555
FAUCET_NETWORK_NAME=Aurora Testnet
FAUCET_NATIVE_SYMBOL=ETH
FAUCET_EXPLORER_URL=https://testnet.aurorascan.dev
FAUCET_PRIVATE_KEY=replace_with_a_dedicated_testnet_wallet_private_key
MOCK_USDC_ADDRESS=0x68F7aAbB357cEF15F8245468f4b66619Bbba051a
DRIP_NATIVE_AMOUNT=0.1
DRIP_AMOUNT_USDC=1000
PORT=3001
# Add deployed frontend origins here, separated by commas. Localhost origins are allowed automatically.
FAUCET_ALLOWED_ORIGINS=https://homr.web.id,https://www.homr.web.id
# Run one faucet process and preserve its data directory across deploys.
FAUCET_MAX_CLAIMS_PER_HOUR=60
# Optional absolute path on a persistent volume. Default: backend/faucet/data/claims.json
# FAUCET_STATE_FILE=/var/lib/homr-faucet/claims.json
