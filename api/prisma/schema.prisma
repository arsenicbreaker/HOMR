generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// B6: origin of a chain event row — real on-chain data vs demo/simulated fallback
enum TxSource {
  ONCHAIN
  SIMULATION
}

model Applicant {
  id           String        @id @default(cuid())
  accountId    String        @unique
  displayName  String
  kycStatus    String        @default("DEMO")
  createdAt    DateTime      @default(now())
  applications Application[]
}

model Application {
  id              String    @id @default(cuid())
  applicantId     String
  applicant       Applicant @relation(fields: [applicantId], references: [id])
  propertyHash    String
  requestedAmount BigInt
  requestedRate   Int
  requestedTerm   Int
  status          String    @default("PENDING")
  maxPrincipal    BigInt?
  reviewedBy      String?
  reviewedAt      DateTime?
  reviewNote      String?
  approvalTxHash  String?
  receiptId       String?
  createdAt       DateTime  @default(now())

  @@index([status])
}

model Auction {
  id               String    @id @default(cuid())
  onchainAuctionId BigInt    @unique
  commitDeadline   DateTime
  revealDeadline   DateTime
  status           String    @default("OPEN")
  createTxHash     String
  finalizeTxHash   String?
  createdAt        DateTime  @default(now())
  bids             Bid[]
}

model Bid {
  id           String    @id @default(cuid())
  auctionId    String
  auction      Auction   @relation(fields: [auctionId], references: [id])
  applicantId  String
  commitment   String
  amount       BigInt?
  rate         Int?
  term         Int?
  revealed     Boolean   @default(false)
  commitTxHash String
  revealTxHash String?
  revealedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([auctionId])
}

model Loan {
  id                 String      @id @default(cuid())
  onchainLoanId      BigInt      @unique
  borrower           String
  principal          BigInt
  remainingPrincipal BigInt?
  rate               Int
  term               Int
  maturity           DateTime
  propertyHash       String
  status             String      @default("ACTIVE")
  createTxHash       String
  createdAt          DateTime    @default(now())
  repayments         Repayment[]

  @@index([status])
}

model Repayment {
  id          String   @id @default(cuid())
  loanId      String
  loan        Loan     @relation(fields: [loanId], references: [id])
  amount      BigInt
  txHash      String
  receiptId   String?  @unique
  blockHeight BigInt
  paidAt      DateTime

  @@index([loanId])
}

model ChainEvent {
  id            String    @id @default(cuid())
  receiptId     String
  logIndex      Int       @default(0)
  txHash        String
  blockHeight   BigInt
  predecessorId String
  eventName     String
  standard      String?
  payload       Json
  txSource      TxSource  @default(ONCHAIN)
  createdAt     DateTime  @default(now())

  @@unique([receiptId, logIndex])
  @@index([eventName])
  @@index([blockHeight])
}

model IndexerCursor {
  id              String   @id @default("singleton")
  lastBlockHeight BigInt
  updatedAt       DateTime @updatedAt
}
