# ==========================================
# Server
# ==========================================
PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# ==========================================
# Database (Gunakan URL Neon/PostgreSQL Anda)
# ==========================================
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
DIRECT_URL=postgresql://user:password@host/db?sslmode=require

# ==========================================
# CORS
# ==========================================
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# ==========================================
# NEAR Network Configuration
# ==========================================
NEAR_NETWORK_ID=testnet
NEAR_RPC_URL=https://rpc.testnet.near.org

# ==========================================
# NEAR Contract Addresses (Ganti setelah deploy)
# ==========================================
CREDIT_AUCTION_CONTRACT_ID=credit-auction.funnylace8065.testnet
HOUSING_VAULT_CONTRACT_ID=housing-vault.funnylace8065.testnet
LOAN_MANAGER_CONTRACT_ID=loan-manager.funnylace8065.testnet
AUDIT_REGISTRY_CONTRACT_ID=audit.funnylace8065.testnet
TOKEN_CONTRACT=mock-token.funnylace8065.testnet

# ==========================================
# Admin signer (faucet mints, admin on-chain actions)
# ==========================================
ADMIN_ACCOUNT_ID=funnylace8065.testnet
# ed25519:... key registered on ADMIN_ACCOUNT_ID. Read by api/src/chain/nearSigner.ts;
# falls back to NEAR_PRIVATE_KEY when unset.
# ADMIN_PRIVATE_KEY=ed25519:...

# ==========================================
# Admin Auth (NEP-413)
# ==========================================
# API Key hanya untuk dev lokal
ADMIN_API_KEY=

# Daftar akun NEAR yang diizinkan sebagai admin (pisahkan dengan koma)
ADMIN_ACCOUNT_IDS=admin.testnet,yyred-max.testnet
NEP413_RECIPIENT=homr-api.testnet